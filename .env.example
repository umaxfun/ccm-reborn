# High Performance Content API endpoint. Used by the schema migration and generator.
HYGRAPH_HP_CONTENT_ENDPOINT=https://<region>.cdn.hygraph.com/content/<project-id>/master

# Management API endpoint for the project's region.
HYGRAPH_MANAGEMENT_ENDPOINT=https://management-<region>.hygraph.com/graphql
HYGRAPH_SCHEMA_MIGRATION_NAME=ccm-reborn-001-initial-campaign-schema-v3

# Regular (read/write) Content API endpoint. Required only by the importer.
HYGRAPH_CONTENT_ENDPOINT=https://<region>.hygraph.com/content/<project-id>/master

# Permanent Auth Token. Give it Management permissions for schema migration and
# Content API create/update/publish permissions for Campaign while importing.
HYGRAPH_TOKEN=

# Required only for `cms:generate -- --upload`.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_BUCKET=ccm-reborn
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://files.ccm-reborn.mikilabs.io

# Discord Desktop local-RPC exporter. This is an OAuth-authorized local client
# integration; it never uses a copied Discord user token or a server bot.
# Create an Application in the Discord Developer Portal, then register this
# exact redirect URI there too. The OAuth consent window is shown by Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_RPC_REDIRECT_URI=http://localhost:3344/discord-rpc

# Optional for `npm run discord:inventory`; narrows channel discovery to one
# server or one forum. For export, provide thread IDs explicitly or with
# --from-inventory.
DISCORD_GUILD_ID=
DISCORD_RPC_FORUM_CHANNEL_ID=
DISCORD_RPC_THREAD_IDS=
DISCORD_RPC_CHANNEL_IDS=
