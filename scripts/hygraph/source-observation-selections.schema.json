{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["selections"],
  "properties": {
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dossierKey", "originMessageId", "latestUpdateMessageId"],
        "properties": {
          "dossierKey": { "type": "string", "minLength": 1 },
          "originMessageId": { "type": "string", "minLength": 1 },
          "latestUpdateMessageId": { "type": "string", "minLength": 1 },
          "contextMessageIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "latestKnownVersion": { "type": "string" },
          "downloadUrl": { "type": "string" },
          "sourceEvidence": { "enum": ["CONTENT_VERIFIED", "NAME_MATCH", "SHARED_REFERENCE"] }
        }
      }
    }
  }
}
